# Porthole SSH Tunnel Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required Settings
# ============================================

# Remote SSH server hostname or IP
SSH_REMOTE_HOST=your-vps-hostname.com

# Remote SSH server port (default: 22)
SSH_REMOTE_PORT=22

# Remote SSH server username
SSH_REMOTE_USER=your-username

# ============================================
# Tunnel Configuration
# ============================================

# Tunnel type: remote, local, dynamic, or custom
# - remote (R): Expose local service on remote server (most common for NAS)
# - local (L): Access remote service locally
# - dynamic (D): SOCKS proxy
# - custom: Provide custom SSH tunnel arguments via SSH_CUSTOM_TUNNEL_ARGS
SSH_TUNNEL_TYPE=remote

# Local port or service to tunnel
# For remote tunnels: the port on your local network/NAS to expose
# For local tunnels: the local port to listen on
# For dynamic tunnels: the local SOCKS proxy port
SSH_TUNNEL_LOCAL_PORT=8080

# Remote port
# For remote tunnels: the port on the remote server that will forward to your local service
# For local tunnels: the remote service port to connect to
SSH_TUNNEL_REMOTE_PORT=8080

# Remote host for tunnel endpoint (default: localhost)
# For remote tunnels: usually "localhost" (the service on your local network)
# For local tunnels: the host on the remote network to connect to
SSH_TUNNEL_REMOTE_HOST=localhost

# Custom tunnel arguments (only used when SSH_TUNNEL_TYPE=custom)
# Example: "-R 8080:localhost:8080 -R 9090:localhost:9090"
# SSH_CUSTOM_TUNNEL_ARGS=

# ============================================
# SSH Authentication
# ============================================

# Option 1: Mount SSH key file (recommended)
# Place your private key in ./ssh-keys/id_rsa
# The docker-compose.yml is configured to mount this directory

# Option 2: Provide SSH private key as environment variable
# Uncomment and paste your private key (including -----BEGIN/END----- lines)
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
# ...your key here...
# -----END OPENSSH PRIVATE KEY-----

# ============================================
# SSH Options
# ============================================

# Disable strict host key checking (yes/no)
# Set to "yes" for better security (requires known_hosts file)
SSH_STRICT_HOST_KEY_CHECKING=no

# Additional SSH arguments (optional)
# Example: "-o ServerAliveInterval=60 -o ServerAliveCountMax=3"
SSH_EXTRA_ARGS=

# ============================================
# AutoSSH Configuration
# ============================================

# AutoSSH monitoring port (0 = disabled, recommended)
AUTOSSH_PORT=0

# Poll interval in seconds (how often to check connection)
AUTOSSH_POLL=60

# First poll delay in seconds
AUTOSSH_FIRST_POLL=30

# Gateway timeout (0 = disabled, don't exit if first connection fails)
AUTOSSH_GATETIME=0

# Log level (0=quiet, 1=errors, 2=info, 3=debug)
AUTOSSH_LOGLEVEL=1

# ============================================
# Other Settings
# ============================================

# Timezone for container logs
TZ=UTC
