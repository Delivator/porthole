# Porthole SSH Tunnel Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required Settings
# ============================================

# Remote SSH server hostname or IP
SSH_REMOTE_HOST=vps.example.com

# Remote SSH server port (default: 22)
SSH_REMOTE_PORT=22

# Remote SSH server username
SSH_REMOTE_USER=your-username

# ============================================
# Tunnel Configuration
# ============================================

# ==== OPTION 1: Multiple Tunnels (Recommended for efficiency) ====
# Define multiple tunnels in a single container using SSH_TUNNELS
# Format: TYPE:ARG1:ARG2:ARG3,TYPE:ARG1:ARG2:ARG3,...
# 
# TYPE can be:
#   R or remote: Remote tunnel - R:remote_port:target_host:target_port
#   L or local:  Local tunnel  - L:local_port:target_host:target_port
#   D or dynamic: SOCKS proxy  - D:local_port
#
# Examples:
#   Single remote tunnel:
#     SSH_TUNNELS=R:8080:localhost:8080
#   
#   Multiple remote tunnels:
#     SSH_TUNNELS=R:8080:localhost:80,R:25565:localhost:25565,R:8443:localhost:443
#   
#   Mixed tunnels (remote + local):
#     SSH_TUNNELS=R:8080:localhost:80,L:3306:dbhost:3306,D:1080
#
# Leave empty to use single tunnel mode below
SSH_TUNNELS=R:8080:localhost:8080

# ============================================
# SSH Authentication
# ============================================

# Option 1: Mount SSH key file (recommended)
# Place your private key in ./ssh-keys/id_ed25519
# The docker-compose.yml is configured to mount this directory

# Option 2: Provide SSH private key as environment variable, will be written to /root/.ssh/id_ed25519
# Uncomment and paste your private key (including -----BEGIN/END----- lines)
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
# ...your key here...
# -----END OPENSSH PRIVATE KEY-----

# ============================================
# SSH Options
# ============================================

# Disable strict host key checking (yes/no)
# Set to "yes" for better security (requires known_hosts file)
SSH_STRICT_HOST_KEY_CHECKING=no

# Additional SSH arguments (optional)
# Example: "-o ServerAliveInterval=60 -o ServerAliveCountMax=3"
SSH_EXTRA_ARGS=

# ============================================
# AutoSSH Configuration
# ============================================

# AutoSSH monitoring port (0 = disabled, recommended)
AUTOSSH_PORT=0

# Poll interval in seconds (how often to check connection)
AUTOSSH_POLL=60

# First poll delay in seconds
AUTOSSH_FIRST_POLL=30

# Gateway timeout (0 = disabled, don't exit if first connection fails)
AUTOSSH_GATETIME=0

# Log level (0=quiet, 1=errors, 2=info, 3=debug)
AUTOSSH_LOGLEVEL=1

# ============================================
# Other Settings
# ============================================

# Timezone for container logs
TZ=UTC
